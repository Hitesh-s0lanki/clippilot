# Copy to .env.local for local development. Example values only - never commit real secrets.

# Base URL of the ClipPilot backend, as reachable from the browser.
# Inlined at build time, so it must be present when `next build` runs.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-side override, used by Server Components and Route Handlers.
# Set this when the server reaches the API on a different host than the browser
# does - for example a container network name in Docker Compose.
# API_BASE_URL=http://backend:8000

# --- Clerk -------------------------------------------------------------------
# Clerk owns sign-up, sign-in and sessions. Create an application at
# https://dashboard.clerk.com and copy both keys from API keys -> Next.js.
#
# The backend must point at the SAME Clerk instance: set CLERK_ISSUER and
# CLERK_JWKS_URL in backend/.env from the same application, or every campaign
# request comes back 401.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Where the account screens live. Clerk reads these itself - `auth()` on the
# server can only see redirect URLs through the environment - so they are the
# single source of truth for both Clerk and `env.authRoutes`.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Where a sign-in or sign-up lands when there is no `redirect_url` to return to.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
