# Copy to .env for local development. Example values only - never commit real secrets.

ENVIRONMENT=development
DEBUG=true

PROJECT_NAME=ClipPilot API
VERSION=0.1.0
API_PREFIX=/api/v1

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3002

# --- Database ---------------------------------------------------------------
# PostgreSQL is the deployment target. The asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://trustvid:trustvid@localhost:5432/trustvid
DATABASE_ECHO=false

# Managed Postgres (Neon, Supabase, RDS) - use the POOLED connection string:
#   DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.aws.neon.tech/trustvid
# Note: asyncpg does not accept a ?sslmode= query parameter. Drop it from the
# URL that the provider gives you; asyncpg negotiates TLS automatically.

# SQLite is supported for a zero-setup local run:
#   DATABASE_URL=sqlite+aiosqlite:///./trustvid.db

# --- Clerk ------------------------------------------------------------------
# Clerk owns sign-up, sign-in and sessions. This service only verifies the
# session JWT the frontend sends and reads the user id from it.
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUDIENCE=

# Development only: accept X-Dev-User-Id instead of a real Clerk token.
# Startup fails if this is true while ENVIRONMENT=production.
ALLOW_DEV_AUTH_HEADER=true

# Salt for hashing event IP addresses. Raw IPs are never stored.
IP_HASH_SALT=dev-only-change-me

# Give an account with no audiences the three sample lists (100 people) on its
# first visit, so a new sign-in lands on a populated segment breakdown rather
# than an empty screen. Set false for a tenant that should start clean.
SAMPLE_AUDIENCES=true

# --- Video storage (AWS S3) -------------------------------------------------
# Leave S3_BUCKET empty to disable uploads: the builder then only accepts a
# pasted public video URL, and the API runs with no AWS account at all.
S3_BUCKET=
S3_REGION=ap-south-1

# Optional. Blank means boto3's own chain is used - shared config, or the
# EC2/ECS/EKS instance role, which is how this should be deployed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3-compatible endpoint for local work (MinIO, LocalStack). Blank = real AWS.
S3_ENDPOINT_URL=

# Key prefix inside the bucket, and the origin objects are read back from.
S3_KEY_PREFIX=campaign-videos
# A CloudFront domain, e.g. https://d1234abcd.cloudfront.net. Blank falls back
# to https://<bucket>.s3.<region>.amazonaws.com, which needs the public-read
# bucket policy in README.md. Must be https either way.
S3_PUBLIC_BASE_URL=

# Leave blank for any bucket created since April 2023 (Object Ownership =
# bucket owner enforced): sending an ACL there fails outright. Older buckets
# with ACLs still enabled can use public-read.
S3_OBJECT_ACL=

S3_UPLOAD_EXPIRES_SECONDS=900
MAX_VIDEO_UPLOAD_BYTES=209715200
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/webm,video/quicktime

# --- AI agents --------------------------------------------------------------
# Agents run on either provider. Leave both keys empty to disable every
# /agents endpoint; the rest of the API is unaffected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto | anthropic | openai. "auto" uses whichever key is present, preferring
# Anthropic when both are. Naming a provider you have no key for disables the
# agents rather than quietly billing the other one.
AGENT_PROVIDER=auto

# Blank means the provider's default - claude-opus-5, or gpt-5.1 for OpenAI.
# Model ids are provider-specific: a Claude id with AGENT_PROVIDER=openai is a
# 404, not a fallback.
AGENT_MODEL=

# Depth of reasoning: low|medium|high on both providers, plus xhigh|max on
# Anthropic only - those two are clamped to high for OpenAI rather than sent
# and rejected. Neither provider's reasoning models take a temperature.
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=240

# --- Firecrawl (MCP) --------------------------------------------------------
# Web research reaches Firecrawl over MCP. Blank does not disable the agents:
# they fall back to the user's own brief and mark the result as researched=false.
# The key travels as a bearer token - never embed it in the URL.
FIRECRAWL_API_KEY=
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_MCP_TIMEOUT_SECONDS=90
